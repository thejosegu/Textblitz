<Window
    x:Class="Blitztext.UI.RecordingOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    ShowInTaskbar="False"
    Topmost="True"
    ResizeMode="NoResize"
    IsHitTestVisible="False"
    ShowActivated="False"
    Focusable="False"
    SizeToContent="WidthAndHeight"
    Opacity="0">

    <Window.Resources>
        <!-- Blink animation for the dot while recording -->
        <Storyboard x:Key="BlinkStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation
                Storyboard.TargetName="Dot"
                Storyboard.TargetProperty="Opacity"
                From="1.0" To="0.12"
                Duration="0:0:0.55"
                AutoReverse="True"/>
        </Storyboard>

        <!-- Fade in -->
        <Storyboard x:Key="FadeInStoryboard">
            <DoubleAnimation
                Storyboard.TargetProperty="Opacity"
                From="0" To="1"
                Duration="0:0:0.18"/>
        </Storyboard>

        <!-- Fade out -->
        <Storyboard x:Key="FadeOutStoryboard">
            <DoubleAnimation
                Storyboard.TargetProperty="Opacity"
                From="1" To="0"
                Duration="0:0:0.25"/>
        </Storyboard>
    </Window.Resources>

    <Border
        CornerRadius="5"
        Background="#F2141414"
        BorderBrush="#50FFFFFF"
        BorderThickness="1"
        Padding="16,9">

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

            <!-- Status dot -->
            <Ellipse
                x:Name="Dot"
                Width="9" Height="9"
                VerticalAlignment="Center"
                Margin="0,1,9,0"/>

            <!-- Mode label (e.g. "Normal", "Plus") -->
            <TextBlock
                x:Name="ModeLabel"
                FontFamily="Segoe UI Variable Text"
                FontSize="13"
                FontWeight="SemiBold"
                Foreground="White"
                VerticalAlignment="Center"/>

            <!-- Separator -->
            <TextBlock
                FontFamily="Segoe UI Variable Text"
                FontSize="13"
                Foreground="#55FFFFFF"
                Text="  ·  "
                VerticalAlignment="Center"/>

            <!-- Status text -->
            <TextBlock
                x:Name="StatusLabel"
                FontFamily="Segoe UI Variable Text"
                FontSize="13"
                Foreground="#CCFFFFFF"
                VerticalAlignment="Center"/>

        </StackPanel>
    </Border>
</Window>
