<Window
    x:Class="Blitztext.UI.ToastWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="420" Height="Auto"
    MinHeight="52"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    ShowInTaskbar="False"
    ShowActivated="False"
    Topmost="True"
    IsHitTestVisible="False"
    ResizeMode="NoResize">

    <Border
        CornerRadius="5"
        Background="#F2181818"
        BorderBrush="#50FFFFFF"
        BorderThickness="1">

        <StackPanel Orientation="Horizontal" Margin="14,10">
            <TextBlock
                Text="⚡"
                FontSize="16"
                VerticalAlignment="Center"
                Margin="0,0,10,0"/>
            <TextBlock
                x:Name="MessageText"
                FontFamily="Segoe UI Variable Text"
                FontSize="13"
                Foreground="White"
                TextWrapping="Wrap"
                MaxWidth="340"
                VerticalAlignment="Center"/>
        </StackPanel>
    </Border>
</Window>
